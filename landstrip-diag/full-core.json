{
  "filesystem": {
    "allowRead": [
      ".",
      "/tmp/pi-agent",
      "/nix/store",
      "/run/current-system",
      "~/.nix-profile",
      "~/.local/state/nix",
      "~/.cache/nix",
      "~/.config/git/ignore",
      "~/.pi",
      "/etc/passwd",
      "/dev/null",
      "/dev/urandom",
      "/dev/random",
      "/dev/zero",
      "/dev/stdin",
      "/dev/stdout",
      "/dev/stderr",
      "/dev/tty"
    ],
    "allowWrite": [
      ".",
      "/tmp/pi-agent",
      "/dev/null",
      "/dev/urandom",
      "/dev/random",
      "/dev/zero",
      "/dev/stdin",
      "/dev/stdout",
      "/dev/stderr",
      "/dev/tty"
    ],
    "denyRead": [
      ".env",
      ".env.local",
      ".env.development",
      ".env.production",
      ".env.test",
      ".env.staging",
      ".envrc",
      ".netrc",
      ".npmrc",
      ".pypirc",
      ".git-credentials",
      "**/.env",
      "**/.env.*",
      "**/*.pem",
      "**/*.key",
      "**/.netrc",
      "**/.npmrc",
      "**/.pypirc",
      "**/.git-credentials",
      "/home",
      "/root",
      "/etc",
      "/run",
      "/var",
      "/var/tmp",
      "/tmp",
      "/proc",
      "/sys",
      "/dev",
      "/mnt",
      "/media",
      "/boot"
    ],
    "denyWrite": [
      ".env",
      ".env.local",
      ".env.development",
      ".env.production",
      ".env.test",
      ".env.staging",
      ".envrc",
      ".netrc",
      ".npmrc",
      ".pypirc",
      ".git-credentials",
      "**/.env",
      "**/.env.*",
      "**/*.pem",
      "**/*.key",
      "**/.netrc",
      "**/.npmrc",
      "**/.pypirc",
      "**/.git-credentials",
      ".pi/"
    ]
  },
  "network": {
    "allowAllUnixSockets": false,
    "allowLocalBinding": false,
    "allowNetwork": false,
    "allowUnixSockets": []
  }
}