{
  "filesystem": {
    "allowRead": [],
    "allowWrite": [
      ".",
      "/tmp/pi-agent",
      "/dev/null",
      "/dev/urandom",
      "/dev/random",
      "/dev/zero",
      "/dev/stdin",
      "/dev/stdout",
      "/dev/stderr",
      "/dev/tty"
